@startuml
title Figura 3. Flujo de ingreso al evento
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false

actor Portero

rectangle "Máquina local" {
  component "Nginx" as Gateway #EDE5FF
  component "checkin\nValida y registra" as Checkin #E4F1FF
  component "tickets\nConsulta de código emitido" as Tickets #E4F1FF
  database "PostgreSQL\ncheckin_db" as CheckinDb #DFF3EE

  Gateway --> Checkin : Código y evento
  Checkin --> Tickets : 2. Verifica el código
  Checkin --> CheckinDb : 3. Registra el primer ingreso
  Gateway <.[norank]. Checkin : 4. Resultado
  Tickets -[hidden]left-> CheckinDb
}

Portero --> Gateway : 1. Escanea o escribe el código
Portero <.[norank]. Gateway : Muestra permiso o motivo
@enduml
