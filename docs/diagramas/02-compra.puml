@startuml
title Figura 2. Flujo de compra
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false

actor Cliente

rectangle "Máquina local" {
  component "Nginx" as Gateway #EDE5FF
  component "orders\nOrquesta la compra" as Orders #E4F1FF
  component "events\nReserva cupos" as Events #E4F1FF
  component "payments\nPago simulado" as Payments #E4F1FF
  component "tickets\nPDF + QR" as Tickets #E4F1FF
  component "notifications\nCorreo de confirmación" as Notifications #E4F1FF
  folder "Carpeta local" as PdfDir #DFF3EE
  component "Mailpit" as Mailpit #DFF3EE

  Gateway --> Orders : Compra pendiente
  Orders --> Events : 2. Reserva
  Orders --> Payments : 3. Pago simulado
  Orders --> Tickets : 4. Emisión
  Orders --> Notifications : 5. Correo
  Tickets --> PdfDir : Guarda PDF
  Notifications --> Mailpit : SMTP

  Events -[hidden]left-> Payments
  Payments -[hidden]left-> Tickets
  Tickets -[hidden]left-> Notifications

  note bottom of Orders
    Cupo insuficiente → Agotado
    Pago rechazado → libera cupos
    Correo fallido → entradas disponibles
  end note
}

Cliente --> Gateway : 1. Confirma en la web
@enduml
