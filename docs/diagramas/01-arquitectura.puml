@startuml
title Figura 1. Arquitectura general de EntradasYa v1
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle

actor Cliente
actor Organizador
actor Portero

rectangle "Máquina local" {
  component "Nginx\nEntrada web y proxy HTTP" as Gateway #EDE5FF

  package "Servicios de aplicación (REST)" as Application {
    component "web\nReact + TypeScript" as Web #E4F1FF
    component "auth\nNode.js + Express\nTypeScript" as Auth #E4F1FF
    component "events\nNode.js + Express\nTypeScript" as Events #E4F1FF
    component "orders\nNode.js + Express\nTypeScript" as Orders #E4F1FF
    component "payments\nNode.js + Express\nTypeScript" as Payments #E4F1FF
    component "tickets\nNode.js + Express\nTypeScript" as Tickets #E4F1FF
    component "notifications\nNode.js + Express\nTypeScript" as Notifications #E4F1FF
    component "checkin\nNode.js + Express\nTypeScript" as Checkin #E4F1FF

    Web -[hidden]down-> Auth
    Auth -[hidden]down-> Events
    Events -[hidden]down-> Orders
    Payments -[hidden]down-> Tickets
    Tickets -[hidden]down-> Notifications
    Notifications -[hidden]down-> Checkin
    Web -[hidden]left-> Payments
    Auth -[hidden]left-> Tickets
    Events -[hidden]left-> Notifications
    Orders -[hidden]left-> Checkin
  }

  package "Datos y soporte" as Support {
    database "PostgreSQL\nSeis bases independientes" as Postgres #DFF3EE
    component "Mailpit\nCorreo de prueba" as Mailpit #DFF3EE
    folder "Carpeta local\nPDF de entradas" as PdfDir #DFF3EE

    Postgres -[hidden]left-> Mailpit
    Mailpit -[hidden]left-> PdfDir
  }

  Gateway --> Application : Web y API pública
  Orders -[hidden]down-> Postgres
  Checkin -[hidden]down-> PdfDir
  Application --> Support
}

Cliente --> Gateway
Organizador --> Gateway
Portero --> Gateway
@enduml
